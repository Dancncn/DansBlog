---
import Layout from '../layouts/BlogPost.astro';
import GoldenSpiral from '../components/GoldenSpiral.astro';
import MeteorShower from '../components/MeteorShower.astro';
import TerminalQuote from '../components/TerminalQuote.astro';

const nowText =
	'Now: Interning at a research institute, working on firmware reverse engineering.';
---

<Layout
	title="About Me - Dan Arnoux (符笙)"
	description="DanArnoux (符笙), currently interning at a research institute and working on firmware reverse engineering. Notes on research, practical engineering, and reproducible systems."
	pubDate={new Date('Feb 10 2026')}
	updatedDate={new Date('2026-10-02')}
	metaMode="page"
	heroImage="https://img.danarnoux.com/misc/about-image.webp"
	profileImage="https://img.danarnoux.com/misc/DanArnoux.webp"
>
	<Fragment slot="background">
		<GoldenSpiral />
		<MeteorShower density={1.8} heightVh={60} />
	</Fragment>
	<div class="mx-auto max-w-3xl">
		<p>
			I am DanArnoux (符笙), from China. I am currently interning at a research institute,
			where my work focuses on firmware reverse engineering. I care about practical engineering,
			clear reasoning, and building systems that can be explained and reproduced.
			This blog is my long-term notebook for experiments, tools, and technical decisions.
		</p>

		<h2>Focus</h2>
		<ul>
			<li>Firmware reverse engineering and practical analysis workflows</li>
			<li>Electrochemistry and materials aging: CV / EIS / ECSA analysis, battery degradation, and characterization</li>
			<li>Simulation and modeling: battery-oriented FEM studies, Simulink models, and reproducible workflows</li>
			<li>
				AI and applied systems: Stable Diffusion, LLM-assisted tooling, and
				<a href="https://creatinf.com/" target="_blank" rel="noreferrer">CreatInf</a>
			</li>
		</ul>

		<h2>Now</h2>
		<div class="mx-auto max-w-2xl text-left">
			<TerminalQuote text={nowText} once={true} fixedHeight={false} />
		</div>

		<h2>Contact</h2>
		<p>
			The best way to reach me is via the
			<button type="button" class="contact-link" data-modal-toggle="contact">contact form</button>
			on this site. You can also find me via GitHub and Bilibili from the site navigation.
		</p>
	</div>
</Layout>

<script>
	document.querySelectorAll('.contact-link').forEach(btn => {
		btn.addEventListener('click', () => {
			const event = new CustomEvent('open-contact-modal');
			window.dispatchEvent(event);
		});
	});
</script>
